{
  "name": "dindayal-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Full-stack Monorepo for Dindayal Jute & Craft (React + TS + Node/Express + Supabase)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "jute",
    "e-commerce",
    "monorepo",
    "react",
    "typescript",
    "express",
    "supabase"
  ],
  "author": "Dindayal Jute & Craft (Indian Jute House)",
  "license": "ISC"
}
